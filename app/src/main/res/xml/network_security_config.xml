<?xml version="1.0" encoding="utf-8"?>
<!--
  This MVP's relay (see the vertical-slice Rust project) speaks plain HTTP,
  no TLS — fine for "two devices on the same machine/LAN talking to a relay
  you're running yourself for development," not fine for anything else.
  Rather than disabling cleartext-traffic protection app-wide, this scopes
  the exception to exactly the hosts a local dev relay is reachable at:
    - 10.0.2.2  : the Android emulator's alias for the host machine's localhost
    - localhost / 127.0.0.1 : a relay running on the same physical device
  Point RelayConfig.baseUrl (see network/RelayApi.kt) at your relay's real
  address; if it's neither of these (e.g. a real LAN IP, or a deployed
  server), add that specific host here explicitly rather than widening this
  to cleartextTrafficPermitted for all domains, and prefer putting a TLS
  reverse proxy in front of the relay for anything beyond local development.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
